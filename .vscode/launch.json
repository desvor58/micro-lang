        },
        {
            "name": "GDB: MIR API benchmark (bubble sort)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/comp/bench_mir_lib",
            "args": [
                "${workspaceFolder}/comp/bubblesort.mir",
                "100",
                "2"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build: benchmarks (gcc)",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "externalConsole": false,
            "stopAtEntry": false,
