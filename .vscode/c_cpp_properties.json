{
    "configurations": [
        {
            "name": "Linux x86-32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/include/**",
                "${workspaceFolder}/tests/**",
                "${workspaceFolder}/tests/include/**",
                "${workspaceFolder}/include",
                "${workspaceFolder}/lib/sct/include"
            ],
            "defines": [
                "_DEBUG"
            ],
            "compilerPath": "/usr/bin/gcc",
            "compilerArgs": [
                "-m32"
            ],
            "cStandard": "c99",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x86"
        }
    ],
    "version": 4
}
