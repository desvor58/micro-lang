{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build: debug (gcc)",
            "type": "shell",
            "command": "make",
            "args": [
                "MODE=debug",
                "microc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build: tests (gcc)",
            "type": "shell",
            "command": "make",
            "args": [
                "MODE=debug",
                "tests/bin/debug/tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build: micro runner (gcc)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-m32",
                "-g",
                "-O0",
                "-o",
                "micro_runner",
                "micro_runner.c",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build: benchmarks (gcc)",
            "type": "shell",
            "command": "python3",
            "args": [
                "comp/build_bench.py",
                "--skip-microc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
