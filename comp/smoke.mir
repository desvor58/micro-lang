# smoke.mir — architecture neutral checksum loop
# Equivalent test for micro-lang, LLVM IR, and GCC MIR backends
#
# i64 checksum(i64* data, i64 n)
# Sums k * data[k] over the array.
#
# The entry function mirrors the harness input preparation of the other
# workloads: 20 descending i32 words, so the result is 1330.

smoke_m:       module
               export checksum
               export main

checksum_p:    proto i64, p:data, i64:n
checksum:      func i64, p:data, i64:n
               local i64:acc, i64:i, i64:addr, i64:off, i64:word

               mov acc, 0
               mov i, 0

loop:
               bge done, i, n

               mul off, i, 4
               add addr, data, off
               mov word, i32:(addr)
               mul word, i, word
               add acc, acc, word

               add i, i, 1
               jmp loop

done:
               ret acc
               endfunc

# --- Entry point: checksum over a 20 element reverse-sorted array ---
main_p:        proto i64
main:          func i64
               local i64:r, i64:arr, i64:n
               alloca arr, 80
               mov n, 20

#              Initialize arr with reverse-sorted values: 20, 19, ..., 1
               mov i32:0(arr), 20
               mov i32:4(arr), 19
               mov i32:8(arr), 18
               mov i32:12(arr), 17
               mov i32:16(arr), 16
               mov i32:20(arr), 15
               mov i32:24(arr), 14
               mov i32:28(arr), 13
               mov i32:32(arr), 12
               mov i32:36(arr), 11
               mov i32:40(arr), 10
               mov i32:44(arr), 9
               mov i32:48(arr), 8
               mov i32:52(arr), 7
               mov i32:56(arr), 6
               mov i32:60(arr), 5
               mov i32:64(arr), 4
               mov i32:68(arr), 3
               mov i32:72(arr), 2
               mov i32:76(arr), 1

               call checksum_p, checksum, r, arr, n
               ret r
               endfunc
               endmodule