# matrixmul.mir — Matrix multiplication C = A * B
# Equivalent test for micro-lang, LLVM IR, and GCC MIR backends
#
# void matrixmul(i64 A, i64 B, i64 C, i64 N)
# Multiplies N x N matrices: C = A * B

matrixmul_m: module
             export matrixmul
             export main

matrixmul_p: proto p:A, p:B, p:C, i64:N
matrixmul:   func p:A, p:B, p:C, i64:N
             local i64:i, i64:j, i64:k, i64:sum
             local i64:row_off, i64:col_off, i64:tmp1, i64:tmp2
             local i64:addr_a, i64:addr_b, i64:addr_c
             local i64:va, i64:vb, i64:prod
             local i64:k_row, i64:k_row_off

             mov i, 0

row_loop:
             bge done, i, N

             mov j, 0

col_loop:
             bge next_row, j, N

             mul row_off, i, N
             mul row_off, row_off, 4

             mov sum, 0
             mov k, 0

dot_loop:
             bge store, k, N

             mul col_off, k, 4

             add tmp1, A, row_off
             add addr_a, tmp1, col_off

             mul k_row, k, N
             mul k_row_off, k_row, 4
             add tmp2, B, k_row_off
             mul col_off, j, 4
             add addr_b, tmp2, col_off

             mov va, i32:(addr_a)
             mov vb, i32:(addr_b)
             mul prod, va, vb
             add sum, sum, prod

             add k, k, 1
             jmp dot_loop

store:
             add tmp1, C, row_off
             add addr_c, tmp1, col_off
             mov i32:(addr_c), sum

             add j, j, 1
             jmp col_loop

next_row:
             add i, i, 1
             jmp row_loop

done:        ret
             endfunc

# --- Entry point: multiply two 10x10 matrices ---
main_p:      proto i64
main:        func i64
             local i64:r, i64:A, i64:B, i64:C

             alloca A, 400
             alloca B, 400
             alloca C, 400

             # Initialize A with 1s, B with 2s
             # (loops left as a simple init pattern)
             mov i64:0(A), 1
             mov i64:4(A), 2
             mov i64:8(A), 3
             mov i64:0(B), 4
             mov i64:4(B), 5
             mov i64:8(B), 6

             call matrixmul_p, matrixmul, A, B, C, 10
             ret 0
             endfunc
             endmodule
