# fibonacci.mir — Recursive Fibonacci
# Equivalent test for micro-lang, LLVM IR, and GCC MIR backends

fib_m:    module
          export fib
          export main

# Recursive Fibonacci: returns fib(n)
# fib(0) = 0, fib(1) = 1, fib(n) = fib(n-1) + fib(n-2)
fib_p:   proto i64, i64:n
fib:     func i64, i64:n
         local i64:a, i64:b, i64:n1, i64:n2, i64:r1, i64:r2
         ble base, n, 1

         sub n1, n, 1
         call fib_p, fib, r1, n1

         sub n2, n, 2
         call fib_p, fib, r2, n2

         add a, r1, r2
         ret a

base:    ret n
         endfunc

# --- Entry point: call fibonacci(30) ---
main_p:  proto i64
main:    func i64
         local i64:r
         call fib_p, fib, r, 30
         ret r
         endfunc
         endmodule
