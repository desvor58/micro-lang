# bubblesort.mir — Bubble sort on an integer array
# Equivalent test for micro-lang, LLVM IR, and GCC MIR backends
#
# void bubblesort(i64* arr, i64 n)
# Sorts arr[0..n-1] in ascending order using bubble sort.

bubblesort_m: module
              export bubblesort
              export main

bubblesort_p: proto p:arr, i64:n
bubblesort:   func p:arr, i64:n
              local i64:i, i64:j, i64:limit, i64:limit2
              local i64:addr_j, i64:addr_j1
              local i64:val_j, i64:val_j1
              local i64:off_j, i64:off_j1, i64:jp1

              mov i, 0

outer_loop:
              sub limit, n, 1
              bge done, i, limit

              mov j, 0
              sub limit2, n, i
              sub limit2, limit2, 1

inner_loop:
              bge inner_done, j, limit2

              mul off_j, j, 4
              add addr_j, arr, off_j

              add jp1, j, 1
              mul off_j1, jp1, 4
              add addr_j1, arr, off_j1

              mov val_j, i32:(addr_j)
              mov val_j1, i32:(addr_j1)

              ble no_swap, val_j, val_j1

              mov i32:(addr_j), val_j1
              mov i32:(addr_j1), val_j

no_swap:
              add j, j, 1
              jmp inner_loop

inner_done:
              add i, i, 1
              jmp outer_loop

done:         ret
              endfunc

# --- Entry point: sort 20-element array ---
main_p:       proto i64
main:         func i64
              local i64:r, i64:arr, i64:n
              alloca arr, 80
              mov n, 20

              # Initialize arr with reverse-sorted values: 20, 19, 18, ..., 1
              mov i32:0(arr), 20
              mov i32:4(arr), 19
              mov i32:8(arr), 18
              mov i32:12(arr), 17
              mov i32:16(arr), 16
              mov i32:20(arr), 15
              mov i32:24(arr), 14
              mov i32:28(arr), 13
              mov i32:32(arr), 12
              mov i32:36(arr), 11
              mov i32:40(arr), 10
              mov i32:44(arr), 9
              mov i32:48(arr), 8
              mov i32:52(arr), 7
              mov i32:56(arr), 6
              mov i32:60(arr), 5
              mov i32:64(arr), 4
              mov i32:68(arr), 3
              mov i32:72(arr), 2
              mov i32:76(arr), 1

              call bubblesort_p, bubblesort, arr, n
              ret 0
              endfunc
              endmodule
